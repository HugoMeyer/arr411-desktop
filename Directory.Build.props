<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <Authors>JoK3RZz</Authors>
    <Company>JoK3RZz</Company>
    <Product>Arr411 Desktop</Product>
    <Copyright>Copyright (c) 2026 JoK3RZz</Copyright>
    <RepositoryUrl>https://github.com/HugoMeyer/arr411-desktop</RepositoryUrl>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!-- Sibling repositories whose JavaScript is embedded as is (set ARR411_ANDROID / ARR411_EXTENSION to use other folders). -->
  <PropertyGroup>
    <AndroidRepo Condition="'$(AndroidRepo)' == '' And '$(ARR411_ANDROID)' != ''">$(ARR411_ANDROID)</AndroidRepo>
    <AndroidRepo Condition="'$(AndroidRepo)' == ''">$(MSBuildThisFileDirectory)..\arr411-android</AndroidRepo>
    <AndroidRepo>$([MSBuild]::NormalizeDirectory('$(AndroidRepo)'))</AndroidRepo>
    <ExtensionRepo Condition="'$(ExtensionRepo)' == '' And '$(ARR411_EXTENSION)' != ''">$(ARR411_EXTENSION)</ExtensionRepo>
    <ExtensionRepo Condition="'$(ExtensionRepo)' == ''">$(MSBuildThisFileDirectory)..\arr411-chrome</ExtensionRepo>
    <ExtensionRepo>$([MSBuild]::NormalizeDirectory('$(ExtensionRepo)'))</ExtensionRepo>
  </PropertyGroup>

</Project>
